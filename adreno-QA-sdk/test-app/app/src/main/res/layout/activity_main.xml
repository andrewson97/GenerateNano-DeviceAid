<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Chat Messages ScrollView -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">
            
            <!-- Chat messages will be added here dynamically -->
            
        </LinearLayout>
    </ScrollView>

    <!-- Modern Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="70dp"
        android:orientation="horizontal"
        android:background="@drawable/input_area_background"
        android:elevation="0dp"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/modern_icon_button"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Clear chat"
            style="?android:attr/borderlessButtonStyle" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <EditText
                android:id="@+id/inputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ask me anything..."
                android:paddingStart="12dp"
                android:paddingEnd="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/modern_input_background"
                android:maxLines="3"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:textColorHint="#9E9E9E"
                android:inputType="textMultiLine|textCapSentences" />

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_microphone"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Voice input"
                style="?android:attr/borderlessButtonStyle" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/modern_send_button_stateful"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Send message"
            style="?android:attr/borderlessButtonStyle"
            android:enabled="true" />
    </LinearLayout>

</LinearLayout>
